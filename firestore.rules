rules_version = '2';

// Puzzle Lab cloud save. One ENCRYPTED document per family, addressed by an unguessable 64-character lookup id
// (derived on the device from the family passphrase). The server never sees names or progress, only ciphertext.
// See docs/sync-design.md. Anyone who knows the id can read/write that one document, so the passphrase must be long.
service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{familyId} {

      function validId() {
        return familyId.matches('[a-f0-9]{64}');
      }

      // exactly these fields: v = format version, rev = revision counter, iv = AES-GCM nonce, ct = ciphertext
      function validShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['v', 'rev', 'iv', 'ct'])
          && d.keys().hasAll(['v', 'rev', 'iv', 'ct'])
          && d.v == 1
          && d.rev is int
          && d.iv is string && d.iv.size() <= 64
          && d.ct is string && d.ct.size() <= 900000;
      }

      // Anonymous sign-in is required (cuts casual drive-by abuse). Listing and deleting are never allowed,
      // so ids cannot be enumerated and a save cannot be wiped by a stranger.
      allow get: if request.auth != null && validId();
      allow create: if request.auth != null && validId() && validShape() && request.resource.data.rev == 1;
      // each write must bump rev by exactly 1, so two devices writing at once cannot silently overwrite each other
      allow update: if request.auth != null && validId() && validShape()
        && request.resource.data.rev == resource.data.rev + 1;
      allow list, delete: if false;
    }

    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
